# =============================================================================
# AgentBridge Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
# All defaults below are suitable for local development.

# ==================== Database ====================
POSTGRES_DB=agentbridge
POSTGRES_USER=agentbridge
POSTGRES_PASSWORD=agentbridge
POSTGRES_PORT=5432
DATABASE_URL=postgres://agentbridge:agentbridge@localhost:5432/agentbridge?sslmode=disable

# ==================== Server ====================
PORT=8080
JWT_SECRET=change-me-in-production
# Comma-separated list of allowed origins for CORS and WebSocket connections.
# Defaults to localhost dev origins when unset.
CORS_ORIGINS=http://localhost:3000

# ==================== Frontend ====================
FRONTEND_PORT=3000
# Leave empty for local dev — auto-derived from page origin in browser.
# Only set explicitly if frontend and backend are on different domains.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/client

# ==================== Email / SMTP ====================
# Uses MailHog for local development (catches all outgoing mail).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@agentbridge.local
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ==================== Podman Compatibility ====================
# Uncomment the line below if you use Podman instead of Docker.
# On macOS with podman machine:
#   DOCKER_HOST=unix:///run/user/$(id -u)/podman/podman.sock
# On Linux (rootless podman):
#   DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock
# DOCKER_HOST=
